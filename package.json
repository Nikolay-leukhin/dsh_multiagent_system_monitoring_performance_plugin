{
  "name": "dsh-workbench-project-console",
  "version": "1.0.3",
  "private": true,
  "description": "Многопроектный пульт: обзор всех проектов по модулям — статусы, прогресс, задачи на контроле и риски по дедлайнам. Русская локализация.",
  "type": "module",
  "license": "MIT",
  "author": "LY",
  "main": "./dsh/server.js",
  "exports": {
    ".": "./dsh/server.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh/",
    "lib/",
    "src/shared/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-workbench-package.mjs",
    "verify": "node scripts/build-client.mjs && node --test test/*.test.js && node scripts/check-workbench-package.mjs",
    "pack:local": "pnpm pack"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OliverLiy/projectHub.git"
  }
}
